{
  "info": {
    "_postman_id": "b9f4a117-8fc1-4f58-a4f2-2cc5fb5a2d90",
    "name": "Student Management Flask SQLite API",
    "description": "Postman collection for the Student Management REST API built with Python, Flask and SQLite. Set the baseUrl collection variable to your local Flask server. Run Create Student and Create Course before requests that use their IDs. The Delete Student request permanently deletes the selected student record; use a test record.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:5000", "type": "string"},
    {"key": "studentId", "value": "1", "type": "string"},
    {"key": "courseId", "value": "1", "type": "string"},
    {"key": "searchQuery", "value": "BCA", "type": "string"}
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"]},
        "description": "Checks whether the Flask API server is running."
      }
    },
    {
      "name": "02 - Create Student (POST)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Student created (201)', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) {", "  const data = pm.response.json();", "  if (data.student_id !== undefined) pm.collectionVariables.set('studentId', String(data.student_id));", "}"]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul-{{$guid}}@example.com\",\n  \"age\": 18,\n  \"course\": \"BCA\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"]},
        "description": "Creates a student. A successful response automatically saves student_id to the studentId collection variable for later requests."
      }
    },
    {
      "name": "03 - Get All Students (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"]}
      }
    },
    {
      "name": "04 - Get Student by ID (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"]}
      }
    },
    {
      "name": "05 - Update Student (PUT)",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Rahul Sharma Updated\",\n  \"email\": \"rahul-updated@example.com\",\n  \"age\": 21,\n  \"course\": \"Python Full Stack\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"]}
      }
    },
    {
      "name": "06 - Partial Update Student (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"age\": 22\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"]}
      }
    },
    {
      "name": "07 - Delete Student (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"]},
        "description": "WARNING: Permanently deletes the student identified by studentId. Use a test record."
      }
    },
    {
      "name": "08 - Search Students (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/students/search?q={{searchQuery}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "search"], "query": [{"key": "q", "value": "{{searchQuery}}"}]}
      }
    },
    {
      "name": "09 - Count Students (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/students/count", "host": ["{{baseUrl}}"], "path": ["api", "students", "count"]}
      }
    },
    {
      "name": "10 - Create Course (POST)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Course created (201)', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) {", "  const data = pm.response.json();", "  if (data.course_id !== undefined) pm.collectionVariables.set('courseId', String(data.course_id));", "}"]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"course_name\": \"Python Full Stack {{$timestamp}}\",\n  \"description\": \"Python Flask SQLite REST API\",\n  \"duration\": \"3 Months\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/courses", "host": ["{{baseUrl}}"], "path": ["api", "courses"]},
        "description": "Creates a course. A successful response automatically saves course_id to the courseId collection variable."
      }
    },
    {
      "name": "11 - Get All Courses (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/courses", "host": ["{{baseUrl}}"], "path": ["api", "courses"]}
      }
    },
    {
      "name": "12 - Get Course by ID (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["api", "courses", "{{courseId}}"]}
      }
    },
    {
      "name": "13 - Student and Course Statistics (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{baseUrl}}/api/stats", "host": ["{{baseUrl}}"], "path": ["api", "stats"]}
      }
    }
  ]
}
